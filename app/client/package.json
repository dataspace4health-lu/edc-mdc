{
  "name": "client",
  "private": true,
  "version": "v4.0.11",
  "type": "module",
  "scripts": {
    "dev": "npx vite",
    "buildOpenAPISchema": "curl -o ./src/zodiosClient/openapi.json http://localhost:8000/openapi.json && npx openapi-zod-client -o ./src/zodiosClient/openapi.json.client.ts ./src/zodiosClient/openapi.json",
    "build": "tsc && npx vite build",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --check .",
    "format:fix": "prettier --write --list-different .",
    "validate": "npm run lint && npm run type-check && npm run format",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@conform-to/react": "^1.1.3",
    "@conform-to/zod": "^1.1.3",
    "@heroicons/react": "^2.1.4",
    "@lnds-lu/design-system": "^0.5.22",
    "@zodios/core": "^10.9.6",
    "axios": "^1.13.0",
    "class-variance-authority": "^0.7.0",
    "date-fns-tz": "^3.0.0",
    "framer-motion": "^12.0.0",
    "just-group-by": "^2.2.0",
    "lunr": "^2.3.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.46.2",
    "react-router": "^6.16.0",
    "react-router-dom": "^6.16.0",
    "react-select": "^5.7.5",
    "tailwind-merge": "^3.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/lunr": "^2.3.6",
    "@types/node": "^22.1.0",
    "@types/react": "18.3.27",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "jsdom": "^28.0.0",
    "postcss": "^8.4.30",
    "prettier": "^3.0.3",
    "prettier-plugin-tailwindcss": "^0.7.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.2.2",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "@babel/runtime": "^7.26.10",
    "brace-expansion": "5.0.3",
    "@zodios/core": {
      "zod": "^4.0.0"
    }
  }
}
