# Mandatory environment variables
DATABASE_URL=sqlite:///./dev.db
ENVIRONMENT=development
APP_URL=http://app.metadata-capture.url

# Mandatory IAM credentials
OPENID_CLIENT_ID=dca-metadata-capture-local
OPENID_CLIENT_SECRET=ask_team_to_provide_you_with_this
OPENID_AUTH_URL=https://id.lnds.lu/auth/realms/lnds-integration/protocol/openid-connect/auth
OPENID_TOKEN_URL=https://id.lnds.lu/auth/realms/lnds-integration/protocol/openid-connect/token
OPENID_JWKS_URL=https://id.lnds.lu/auth/realms/lnds-integration/protocol/openid-connect/certs
OPENID_END_SESSION_URL=https://id.lnds.lu/auth/realms/lnds-integration/protocol/openid-connect/logout
SESSION_SECRET_KEY=secret_key
SESSION_ENCRYPTION_KEY=encryption_key
OPENID_VERIFY=False

# Optional Bot Service Account Authentication (for automated API access)
# Each service account will automatically get its own user based on JWT 'sub' claim
# BOT_SERVICE_CLIENT_ID=bot-service-client-id
# BOT_SERVICE_AUDIENCE=dca-metadata-capture-local

# Mandatory SMTP configuration
SMTP_SERVER=localhost
SMTP_PORT=1025
SMTP_USERNAME=smtp-username
SMTP_PASSWORD=smtp-password
SENDER_EMAIL=sender@email.com

# Optional OpenTelmetry configuration
OTL_URL=http://localhost:5080/api/default/v1/traces
OTL_TOKEN=not_required_in_local

# Optional S3 configuration to upload dataset rdf
S3_BUCKET=idc-dev
S3_ENDPOINT_URL=https://s3-luxembourg.obj.ebrc.com:443
AWS_ACCESS_KEY_ID=key
AWS_SECRET_ACCESS_KEY=secret

# Set this for the first time to load initial data
LOAD_INITIAL_DATA=True

# Optional Certs env vars and also if you use certs
# DB_SSL_MODE=require
# DB_SSL_CERT=./../e2e/certs/client-cert.pem
# DB_SSL_KEY=./../e2e/certs/client-key.pem
# DB_SSL_ROOT_CERT=./../e2e/certs/ca-cert.pem
# MIGRATION_DB_SSL_MODE=require
# MIGRATION_DB_SSL_CERT=./../e2e/certs/client-cert.pem
# MIGRATION_DB_SSL_KEY=./../e2e/certs/client-key.pem 
# MIGRATION_DB_SSL_ROOT_CERT=./../e2e/certs/ca-cert.pem

# Optional For pushing publishing datasets RDF to a FTPS location
FRONT_OFFICE_HOST=localhost
FRONT_OFFICE_PORT=21
FRONT_OFFICE_USER=testuser
FRONT_OFFICE_PASSWORD=TestPass123!
FRONT_OFFICE_UPLOAD_PATH=/ftp/testuser
#
# For AVSCAN Anti-Virus
AVSCAN_API_KEY=
AVSCAN_API_URL=
#
# For Legilux endpoint proxy
LEGILUX_ENDPOINT = https://data.legilux.public.lu/sparqlendpoint
#
# For EUR-Lex Web Service
# Register at: https://eur-lex.europa.eu/content/help/data-reuse/webservice.html
EURLEX_USERNAME=your_eu_login_email@example.com
EURLEX_PASSWORD=your_password_from_eurlex_email
#
# Logs
LOG_FORMAT=json
LOG_LEVEL=INFO
LOG_FILE_PATH=/logs/metadata-capture.log

# For turning on background jobs
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Cron schedule for importing datasets (crontab minute format, default: every 5 minutes)
IMPORT_DATASETS_CRON_SCHEDULE=*/5

# For importing datasets from source instance
SOURCE_INSTANCE_URL=https://another-catalogue
SOURCE_INSTANCE_NAME=lnds-mdc
SOURCE_DATASET_URL_PATTERN=/?datasetId=={id}
SYNC_USER_ID=1

# Optional Service Account Authentication for source instance
SOURCE_OIDC_ISSUER_URL=https://id.lnds.lu/auth/realms/lnds-integration
SOURCE_SERVICE_ACCOUNT_CLIENT_ID=bot-mdc-service-client
SOURCE_SERVICE_ACCOUNT_CLIENT_SECRET=your-client-secret

# For setting default access url for distribution
DEFAULT_ACCESS_URL=https://default-access-url-for-distribution
